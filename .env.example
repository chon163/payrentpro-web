# ค่าที่จำเป็น — Supabase project (ได้จาก Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ไม่บังคับ — โดเมนสำหรับลิงก์บิล /bill/:token
# ถ้าไม่ใส่ ระบบใช้ window.location.origin ของหน้าที่เปิดอยู่อัตโนมัติ
# VITE_BILL_BASE_URL=https://bill.yourdomain.com

# ไม่บังคับ — แสดง ID บอท LINE ในหน้าคู่มือผูก LINE
# ถ้าไม่ใส่ จะแสดงข้อความ "ดู ID บอทในคู่มือ" แทน
# VITE_LINE_BOT_ID=@your-line-bot

# ไม่บังคับ — ปลายทางหลัง Google OAuth ส่งกลับ
# ถ้าไม่ใส่ ใช้ window.location.origin ของหน้าที่เปิดอยู่ (localhost ตอน dev /
# โดเมนจริงตอน production) ซึ่งเป็นสิ่งที่ต้องการเกือบทุกกรณี
# ใส่เฉพาะกรณีต้องบังคับให้กลับไปโดเมนอื่น
# ทุก origin ที่ใช้ต้องอยู่ใน Supabase > Authentication > URL Configuration > Redirect URLs
# VITE_OAUTH_REDIRECT_TO=https://payrentpro-web.vercel.app

# หมายเหตุ: ไฟล์ .env / .env.production ถูก .gitignore แล้ว (ห้าม commit ค่าจริง)
